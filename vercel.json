{
  "version": 2,
  "builds": [
    {
      "src": "api/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/games", "dest": "api/app.py" },
    { "src": "/game/(.*)", "dest": "api/app.py" },
    { "src": "/screenshots/(.*)", "dest": "api/app.py" },
    { "src": "/trailers/(.*)", "dest": "api/app.py" },
    { "src": "/trending", "dest": "api/app.py" },
    { "src": "/top-rated", "dest": "api/app.py" },
    { "src": "/new-releases", "dest": "api/app.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}